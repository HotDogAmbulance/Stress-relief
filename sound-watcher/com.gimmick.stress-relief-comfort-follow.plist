<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gimmick.stress-relief-comfort-follow</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Applications/Stress-relief/sound-watcher/Stress-relief Sound Watcher.app/Contents/MacOS/Stress-relief Sound Watcher</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/Users/gimmick/Library/Logs/stress-relief-watcher.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/gimmick/Library/Logs/stress-relief-watcher.log</string>
</dict>
</plist>
